# Normalize text files to LF in Git
* text=auto eol=lf

# Markdown
*.md text eol=lf

# TypeScript / JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# Configuration
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env.example text eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf