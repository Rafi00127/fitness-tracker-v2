generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  name             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  refreshTokens    RefreshToken[]
  profile          Profile?
  exercises        Exercise[]
  workouts         Workout[]
  waterEntries     WaterEntry[]
  measurements     Measurement[]
  goals            Goal[]
  nutritionEntries NutritionEntry[]
  plans            Plan[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Profile {
  userId     String     @id
  heightCm   Decimal?   @db.Decimal(5, 2)
  weightUnit WeightUnit @default(KG)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id             String            @id @default(cuid())
  userId         String
  name           String            @db.VarChar(100)
  category       String?           @db.VarChar(60)
  notes          String?           @db.VarChar(1000)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutEntries WorkoutExercise[]

  @@index([userId, name])
}

model Workout {
  id              String            @id @default(cuid())
  userId          String
  title           String            @db.VarChar(120)
  date            DateTime
  durationMinutes Int?
  notes           String?           @db.VarChar(2000)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseEntries WorkoutExercise[]
  planItem        PlanItem?

  @@index([userId, date])
}

model WorkoutExercise {
  id              String   @id @default(cuid())
  workoutId       String
  exerciseId      String
  sets            Int?
  reps            Int?
  weight          Decimal? @db.Decimal(7, 2)
  durationSeconds Int?
  notes           String?  @db.VarChar(1000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workout         Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([workoutId])
  @@index([exerciseId])
}

model WaterEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  amountMl  Int
  notes     String?  @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Measurement {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  weightKg       Decimal? @db.Decimal(7, 3)
  waistCm        Decimal? @db.Decimal(7, 2)
  chestCm        Decimal? @db.Decimal(7, 2)
  hipCm          Decimal? @db.Decimal(7, 2)
  bicepsCm       Decimal? @db.Decimal(7, 2)
  bodyFatPercent Decimal? @db.Decimal(5, 2)
  notes          String?  @db.VarChar(1000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Goal {
  id               String     @id @default(cuid())
  userId           String
  title            String     @db.VarChar(100)
  metric           GoalMetric
  targetValue      Decimal    @db.Decimal(10, 3)
  targetDate       DateTime?  @db.Date
  startingWeightKg Decimal?   @db.Decimal(7, 3)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NutritionEntry {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  description  String   @db.VarChar(120)
  caloriesKcal Int?
  proteinGrams Decimal? @db.Decimal(7, 2)
  carbsGrams   Decimal? @db.Decimal(7, 2)
  fatsGrams    Decimal? @db.Decimal(7, 2)
  notes        String?  @db.VarChar(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Plan {
  id          String     @id @default(cuid())
  userId      String
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(1000)
  startDate   DateTime?  @db.Date
  endDate     DateTime?  @db.Date
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       PlanItem[]

  @@index([userId, createdAt])
}

model PlanItem {
  id            String    @id @default(cuid())
  planId        String
  title         String    @db.VarChar(120)
  scheduledDate DateTime  @db.Date
  notes         String?   @db.VarChar(1000)
  workoutId     String?   @unique
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  plan          Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  workout       Workout?  @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@index([planId, scheduledDate])
  @@index([scheduledDate])
}

enum WeightUnit {
  KG
  LB
}

enum GoalMetric {
  DAILY_WATER_ML
  WEEKLY_WORKOUTS
  TARGET_WEIGHT_KG
}
